# =====================================================================
#  The_Og API -- ENV variables (ziba ku iseriveri, NTIZIJYA kuri GitHub)
#  Kuri Render/Railway: Environment → Add variable (imwe imwe)
# =====================================================================

# 🔐 Ijambo ry'ibanga rya admin (RIREMYE, 32+ inyuguti). Kurikora:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=shyiramo-ijambo-ryibanga-rirerire

# 🗄️ Database ihoraho (Neon / Supabase Postgres). Iyo ititanzwe, hakoreshwa SQLite
#    (ISIBAMA iyo seriveri yongeye gutangira ku bwoko bw'ubuntu!).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 🔌 Keys nyazo z'abatanga serivisi (shyiramo ZIKORESHWA GUSA; umukiriya ntazibona)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxx
# MISTRAL_API_KEY=xxxxxxxxxxxx
# DEEPSEEK_API_KEY=xxxxxxxxxxxx
# OPENROUTER_API_KEY=xxxxxxxxxxxx
# TOGETHER_API_KEY=xxxxxxxxxxxx
# XAI_API_KEY=xxxxxxxxxxxx
# Keys nyinshi z'umutanga umwe:  GROQ_API_KEYS=["gsk_1","gsk_2"]

# ↕️ Urutonde rwo kugerageza (ubishaka)
# PROVIDER_ORDER=groq,anthropic,openai

# ✏️ Guhindura models (ubishaka)
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-haiku-5-5

# 🎭 Imiterere ya AI (ubishaka). Gusiba byose: OG_SYSTEM_PROMPT=" "
# OG_SYSTEM_PROMPT=You are The_Og AI, ...

# 🌐 Imbuga zemerewe guhamagara mu browser (isanzwe: zose)
# ALLOWED_ORIGINS=https://umbuga-wawe.com
